# ---------------------------------------------------------------------------
# Session signing. Any long random string. Required in production.
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Supabase. Leave these blank to run on the built-in demo cohort, where patient
# records are a fixture and what the patient records is kept in a signed cookie.
#
# Apply `supabase/migrations/0001_web_portal.sql` first -- schema and the three
# demo patients in one paste. `supabase/seed_local.sql` is optional on top.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security completely. It is used
# here on purpose -- this app authenticates patients with Twilio Verify and its
# own session cookie, so there is no Supabase JWT for a policy to key on, and
# the `web_*` tables are locked to the service role instead. See the note at the
# top of `src/lib/supabase.ts`.
#
# Neither of these is prefixed NEXT_PUBLIC_, and nothing client-side imports the
# Supabase client. If the service role key ever reaches a commit, rotate it:
# deleting the commit is not enough, assume anything pushed has been scraped.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# demo | supabase. Left blank it follows whether the two variables above are
# set. A production build refuses to serve the demo cohort either way.
PATIENT_SOURCE=

# ---------------------------------------------------------------------------
# Twilio Verify. Leave these blank to run in demo mode, where the one-time code
# is printed to the server console instead of being sent by SMS.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Seconds a patient must wait before asking for another code. Enforced per
# number once Supabase is configured, per device otherwise.
OTP_RESEND_SECONDS=60
# Numbers that skip Twilio and show their code on the sign-in screen (and in
# the server console), while every other number still gets a real SMS. For
# demoing on a Twilio trial account, which only delivers to numbers verified in
# the Twilio console. Every number here is public -- the sign-in page offers
# them and shows their code to anyone -- so list fictional demo patients only.
# Ignored when NODE_ENV=production, unless the switch below is also set.
DEMO_PHONES=""
# A hosted prototype only: "true" lets DEMO_PHONES work in production too.
ALLOW_DEMO_PHONES_IN_PRODUCTION=


# ---------------------------------------------------------------------------
# The overnight assistant. Without a key the Ask tab answers honestly that it is
# switched off and gives the escalation route, rather than inventing anything.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Medication photo transcription (uses the same server-side API key).
OPENAI_MEDICATION_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# /admin, for adding patients and setting their procedure dates. Left blank,
# /admin does not exist at all. Set, it is one shared password for everyone who
# runs the pilot, so make it long: openssl rand -base64 24
# Needs Supabase -- the demo cohort is code and there is nothing to edit.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=

# Public origin, used to build the QR code target.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Dose reminders over Telegram ───────────────────────────────────────────
# The calendar export alarms a patient's phone, but only if they tapped "Add to
# calendar". These are the reminders that need nothing from them on the night.
#
# Set up: message @BotFather on Telegram, /newbot, and paste the token here.
TELEGRAM_BOT_TOKEN=
# The bot's @name without the @. Used to build the t.me link the patient taps.
# No username means the connect card is not shown at all.
TELEGRAM_BOT_USERNAME=
# Any long random string. Telegram echoes it back on every update, which is what
# stops anyone who finds the webhook path from linking themselves to a patient.
#   openssl rand -base64 32
TELEGRAM_WEBHOOK_SECRET=
# Guards /api/reminders/send. Must match the header in the Supabase cron job in
# supabase/migrations/0004_reminders.sql. Unset means the endpoint refuses.
#   openssl rand -base64 32
REMINDER_CRON_SECRET=
# The safety switch. Anything other than `true` and a run logs exactly who it
# WOULD have messaged, about which dose, without calling Telegram. Leave it off
# until you have watched a full purge night in the logs.
REMINDERS_ENABLED=false
